{
  "format": "fitom-chip-capabilities",
  "format_version": 1,
  "description": "チップ種別(VoicePatchType)ごとに、HwPatch(*.hwbank.json)のどのフィールドが実際に意味を持ち、値域・実効解像度・排他条件がどうなるかを機械可読な形で定義する。hwbank.schema.jsonはフィールド型の共通上限しか表現できないため、チップ単位の妥当性検証・UI構築はこのファイルを参照する。読み方はspec/README.md、背景はdocs/manuals/hwpatch-reference.mdを参照。",

  "conventions": {
    "chip_params_are_exhaustive": "chips[].params に列挙されていないパラメータは、そのチップのドライバが一切参照しない(値を書いても無視される)。エディタは非表示または無効表示にしてよい。",
    "range": "[min, max]。そのチップで意味を持つ値域。hwbank.schema.jsonの型上限より狭いことがある。",
    "effective_range": "range内で実際に音へ反映される範囲。これを外れた値はクランプ・飽和する。省略時はrangeと同じ。",
    "quantum": "実機レジスタ1段に対応するパッチ値の刻み。省略時1。例えば2なら、隣り合う奇偶の値は同じレジスタ値になる。",
    "register_bits": "対応する実機レジスタのビット幅。",
    "mapping": "direct=値がそのままレジスタへ / attenuation_db=減衰量(0=最大音量、パッチ値1あたりstep_dB。quantumがある場合、実機レジスタが1段動くのはquantum刻み=quantum×step_dB dBごと) / bitfield=ビットごとに別の意味 / enum=values[]の離散値 / index=テーブルへの索引 / raw=チップ固有の生値",
    "condition": "そのパラメータが有効になる条件。param(+mask)とequals/not_equals/inで他フィールドの値を、channelsで発音チャンネル番号を制約する。条件を満たさない場合そのパラメータは参照されない。",
    "per_op": "オペレータ番号ごとの上書き定義。キーはops[]の添字。親の定義に分岐先の定義を重ねて解決し、分岐先に無いキーは親の値を使う。キーが無いオペレータではそのパラメータは参照されない。",
    "per_condition": "条件によって意味そのものが変わるパラメータの定義。各要素のconditionを評価し、成立した要素の定義を親の定義へ重ねて解決する。有効/無効だけが変わる場合はconditionを使う。",
    "same_params_as": "params が空で、別のチップ定義をそのまま流用することを示す。エディタは参照先のparamsを解決して使う。",
    "driver_support": "省略時(=通常)はドライバがレジスタへ書き込む。\"pending\" はチップの音色パラメータとしては有効だが現在のドライバがまだ書いていないもので、値は音色データとして保持する必要がある(エディタは編集可能にし、検証ツールは値を捨てたり警告にしたりしてはならない)。"
  },

  "patch_kinds": {
    "fm": "HwPatch(ops[]付き)で音色を記述する。*.hwbank.jsonの対象。",
    "builtin_rom": "音色がチップROM固定でユーザー音色を持たない。HwBankを作成できない。",
    "sample_zone": "SampleZonePatch(*.samplezonebank.json)を使う。HwPatchのops[]は一切使わない。",
    "mode_selector": "特定チップを指さないバンク選択子。音色データを持たない。",
    "unimplemented": "VoicePatchTypeの値のみ予約。ドライバ未実装。"
  },

  "parameters": {
    "FB": {"scope": "channel", "path": "FB", "type": "integer", "schema_range": [0, 7], "label": "Feedback"},
    "ALG": {"scope": "channel", "path": "ALG", "type": "integer", "schema_range": [0, 7], "label": "Algorithm"},
    "AMS": {"scope": "channel", "path": "AMS", "type": "integer", "schema_range": [0, 3], "label": "AM Sensitivity"},
    "PMS": {"scope": "channel", "path": "PMS", "type": "integer", "schema_range": [0, 7], "label": "PM Sensitivity"},
    "NFQ": {"scope": "channel", "path": "NFQ", "type": "integer", "schema_range": [0, 31], "label": "Noise Frequency"},
    "FB2": {"scope": "channel", "path": "FB2", "type": "integer", "schema_range": [0, 7], "label": "Feedback (後半ペア)"},

    "AR": {"scope": "operator", "path": "ops[i].AR", "type": "integer", "schema_range": [0, 31], "label": "Attack Rate"},
    "DR": {"scope": "operator", "path": "ops[i].DR", "type": "integer", "schema_range": [0, 31], "label": "Decay Rate"},
    "SL": {"scope": "operator", "path": "ops[i].SL", "type": "integer", "schema_range": [0, 15], "label": "Sustain Level (減衰量、大きいほど小音量)"},
    "SR": {"scope": "operator", "path": "ops[i].SR", "type": "integer", "schema_range": [0, 31], "label": "Sustain Rate"},
    "RR": {"scope": "operator", "path": "ops[i].RR", "type": "integer", "schema_range": [0, 15], "label": "Release Rate"},
    "TL": {"scope": "operator", "path": "ops[i].TL", "type": "integer", "schema_range": [0, 127], "label": "Total Level (減衰量、0=最大音量)"},
    "KSR": {"scope": "operator", "path": "ops[i].KSR", "type": "integer", "schema_range": [0, 3], "label": "Key Scale Rate"},
    "KSL": {"scope": "operator", "path": "ops[i].KSL", "type": "integer", "schema_range": [0, 3], "label": "Key Scale Level"},
    "MUL": {"scope": "operator", "path": "ops[i].MUL", "type": "integer", "schema_range": [0, 15], "label": "Multiple"},
    "DT1": {"scope": "operator", "path": "ops[i].DT1", "type": "integer", "schema_range": [0, 7], "label": "Detune 1"},
    "DT2": {"scope": "operator", "path": "ops[i].DT2", "type": "integer", "schema_range": [0, 3], "label": "Detune 2"},
    "PDT": {"scope": "operator", "path": "ops[i].PDT", "type": "integer", "schema_range": [-32768, 32767], "label": "疑似デチューン/拡張周波数オフセット"},
    "AM": {"scope": "operator", "path": "ops[i].AM", "type": "integer", "schema_range": [0, 1], "label": "AM Enable"},
    "VIB": {"scope": "operator", "path": "ops[i].VIB", "type": "integer", "schema_range": [0, 1], "label": "Vibrato Enable"},
    "EGT": {"scope": "operator", "path": "ops[i].EGT", "type": "integer", "schema_range": [0, 15], "label": "EG Type / SSG-EG / HWエンベロープ制御"},
    "WS": {"scope": "operator", "path": "ops[i].WS", "type": "integer", "schema_range": [0, 127], "label": "Wave Select"},
    "REV": {"scope": "operator", "path": "ops[i].REV", "type": "integer", "schema_range": [0, 7], "label": "Reverberation"},
    "EGS": {"scope": "operator", "path": "ops[i].EGS", "type": "integer", "schema_range": [0, 127], "label": "EG Bias"},
    "DT3": {"scope": "operator", "path": "ops[i].DT3", "type": "integer", "schema_range": [0, 15], "label": "Fine Frequency (ratio mode)"},

    "FIX": {"scope": "ext", "path": "ext.FIX", "type": "integer", "schema_range": [0, 3], "label": "Fixed Frequency / FXモード"},
    "ALG_EXT": {"scope": "ext", "path": "ext.ALG_EXT", "type": "integer", "schema_range": [0, 1], "label": "ALG拡張ビット"},
    "HWEP": {"scope": "ext", "path": "ext.HWEP", "type": "integer", "schema_range": [0, 65535], "label": "HW Envelope Period"},
    "target_voice_patch_type": {"scope": "ext", "path": "ext.target_voice_patch_type", "type": "integer", "schema_range": [0, 255], "label": "対象チップ(PSG系共有バンク専用)"},
    "rhythm_ch": {"scope": "ext", "path": "ext.rhythm_ch", "type": "integer", "schema_range": [0, 255], "label": "対象リズムチャンネル(楽器)"}
  },

  "common_patch_fields": {
    "prog": {"path": "prog", "type": "integer", "range": [0, 127], "required": true, "note": "Program Change番号。builtin参照エントリでは格納スロット番号にすぎず任意。"},
    "name": {"path": "name", "type": "string", "note": "音色名。"},
    "sw_bank": {"path": "sw_bank", "type": "integer", "range": [-1, 127], "default": -1, "note": "参照するSwPatchのバンク番号。-1=参照なし。全チップ共通。"},
    "sw_prog": {"path": "sw_prog", "type": "integer", "range": [-1, 127], "default": -1, "note": "参照するSwPatchのプログラム番号。-1=参照なし。全チップ共通。"}
  },

