{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "fitom",
  "version": "2.0.0",
  "description": "FITOM_X の依存ライブラリ。vcpkg のツールチェーンを指定して configure すると取得される。",
  "dependencies": [
    { "name": "boost-thread",       "platform": "!emscripten" },
    { "name": "boost-format",       "platform": "!emscripten" },
    { "name": "boost-log",          "platform": "!emscripten" },
    "nlohmann-json",
    {
      "name": "rtmidi",
      "features": [ { "name": "alsa", "platform": "linux" } ]
    },
    "catch2"
  ],
  "features": {
    "gui": {
      "description": "Dear ImGui GUI (apps/fitom_gui)。FITOM_GUI_IMGUI=ON のときに CMakeLists.txt が選ぶ",
      "dependencies": [
        "glfw3",
        {
          "name": "imgui",
          "features": [ "glfw-binding", "opengl3-binding" ]
        }
      ]
    }
  },
  "$comment-overrides": "ImGui は apps/fitom_gui を確かめた 1.92.8 に固定する。上げるときは GUI の目視確認とセットで行う",
  "overrides": [
    { "name": "imgui", "version": "1.92.8", "port-version": 1 }
  ],
  "$comment-overlay": "rtmidi は上流のポートが 6.0.0 までなので、6.1.0 を vcpkg-ports/rtmidi に持つ",
  "vcpkg-configuration": {
    "overlay-ports": [ "./vcpkg-ports" ]
  },
  "builtin-baseline": "528cfa41f4b1578b16ac6b2f6d2e6f98e5308d2d"
}
